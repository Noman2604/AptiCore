# ==========================================
# AptiCore Environment Variables Configuration
# ==========================================

# Application Config
APP_NAME=AptiCore
APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database (MongoDB Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/?appName=AptiCore
MONGODB_URI="mongodb://localhost:27017/apticore"

# Authentication (JSON Web Token Secret)
# Generate a random 32+ char secret in terminal: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key"

# Cloudinary (Image & File Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ==========================================
# Email Service (Nodemailer / SMTP Settings)
# ==========================================
# For Gmail:
# 1. Go to Google Account -> Security -> 2-Step Verification (Enable it)
# 2. Search for "App Passwords" (https://myaccount.google.com/apppasswords)
# 3. Create an App password named "AptiCore", copy the 16-character code
# 4. Paste below in SMTP_PASS (without spaces)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="AptiCore <your-email@gmail.com>"

# Email Token Expiry (e.g. 15m, 1h, 24h)
EMAIL_VERIFICATION_EXPIRES=24h
